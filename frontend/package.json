{
  "name": "portpolio",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "CI=false && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "vite build && playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --check ./src ./scripts ./e2e vite.config.ts vitest.config.ts eslint.config.js playwright.config.ts",
    "format:fix": "prettier --write ./src ./scripts ./e2e vite.config.ts vitest.config.ts eslint.config.js playwright.config.ts",
    "gen": "npx supabase gen types typescript --project-id \"$VITE_SUPABASE_PROJECT_ID\" --schema public > src/types/supabase.ts",
    "perf": "bash scripts/perf/measure.sh",
    "perf:compare": "node scripts/perf/compare.mjs",
    "perf:bundle": "node scripts/perf/bundle-size.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.0",
    "@supabase/supabase-js": "^2.48.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tiptap/extension-code-block-lowlight": "^2.11.5",
    "@tiptap/extension-image": "^2.11.5",
    "@tiptap/extension-link": "^2.11.5",
    "@tiptap/extension-list-item": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "lowlight": "^3.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.29.0",
    "tiptap-extension-resize-image": "^1.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "30.0.1",
    "lighthouse": "12.8.2",
    "msw": "2.15.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.10",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "3.2.7"
  },
  "homepage": "https://minginew.netlify.app"
}
